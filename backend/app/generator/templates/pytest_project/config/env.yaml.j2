project_id: {{ project.id }}
project_name: "{{ project.name }}"
environment_id: {{ environment.id }}
environment_name: "{{ environment.name }}"
base_url: "{{ environment.base_url }}"
headers:
{% for key, value in (environment.headers or {}).items() %}
  {{ key }}: {{ value | tojson }}
{% endfor %}
variables:
{% for key, value in (environment.variables or {}).items() %}
  {{ key }}: {{ value | tojson }}
{% endfor %}
timeout: {{ timeout }}
retry_count: {{ retry_count }}
auth:
  auth_type: {{ auth.auth_type | tojson }}
  token: {{ auth.token | tojson }}
  cookie: {{ auth.cookie | tojson }}
  auth_config:
{% for key, value in (auth.auth_config or {}).items() %}
    {{ key }}: {{ value | tojson }}
{% endfor %}
